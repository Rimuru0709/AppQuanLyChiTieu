<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đặt mục tiêu tiết kiệm"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#000"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0D6EFD"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mục tiêu của bạn"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/txtGoalMoney"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50.000.000 đ"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="28sp"/>

                <ProgressBar
                    android:id="@+id/progressGoal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="25"
                    android:layout_marginTop="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/txtSaved"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Đã tiết kiệm: 12.500.000 đ"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/txtRemain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Còn: 37.500.000 đ"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên mục tiêu"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Du lịch Đà Nẵng"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số tiền mục tiêu"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/edtMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="50000000"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thời hạn (tháng)"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/edtMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="12"
            android:inputType="number"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiết kiệm mỗi tháng"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/txtMonthly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 đ"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tự động chuyển tiền tiết kiệm"
                android:textSize="16sp"/>

            <Switch
                android:id="@+id/swAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu mục tiêu"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>