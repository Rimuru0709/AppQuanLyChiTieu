<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="@color/card_background"
    android:elevation="10dp"
    android:gravity="center"
    android:minHeight="70dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="5dp"
    android:paddingEnd="6dp"
    android:paddingBottom="5dp">

    <!-- Trang chủ -->
    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Trang chủ"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home" />

        <TextView
            android:id="@+id/tvHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Trang chủ"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Thống kê -->
    <LinearLayout
        android:id="@+id/navStatistic"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgStatistic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Thống kê"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_statistic" />

        <TextView
            android:id="@+id/tvStatistic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Thống kê"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Thêm giao dịch -->
    <LinearLayout
        android:id="@+id/navAdd"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgAdd"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Thêm giao dịch"
            android:scaleType="fitCenter"
            android:src="@drawable/bg_circle_blue" />

        <TextView
            android:id="@+id/tvAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Thêm"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Cảnh báo -->
    <LinearLayout
        android:id="@+id/navAlert"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgAlert"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Cảnh báo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_warning" />

        <TextView
            android:id="@+id/tvAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Cảnh báo"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Cài đặt -->
    <LinearLayout
        android:id="@+id/navSetting"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgSetting"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Cài đặt"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_setting" />

        <TextView
            android:id="@+id/tvSetting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Cài đặt"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>