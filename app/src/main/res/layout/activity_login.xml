<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A47C9"
    tools:context=".activity.LoginActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:fontFamily="sans-serif"
        android:text="Chào mừng bạn đã trở lại"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Quản lý chi tiêu thông minh"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgOwl"
        android:layout_width="155dp"
        android:layout_height="139dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="338dp"
        android:layout_height="57dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_email"
        android:drawablePadding="10dp"
        android:imeOptions="actionNext"
        android:hint="Email hoặc số điện thoại"
        android:inputType="textEmailAddress"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:textSize="16sp"

        app:layout_constraintTop_toBottomOf="@id/imgOwl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <EditText
        android:id="@+id/edtPassword"
        android:layout_width="340dp"
        android:layout_height="53dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_lock"
        android:drawableEnd="@drawable/ic_eye_off"
        android:drawablePadding="10dp"
        android:imeOptions="actionDone"
        android:hint="Mật khẩu"
        android:inputType="textPassword"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/edtEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <CheckBox
        android:id="@+id/chkRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:buttonTint="#FFFFFF"
        android:text="Ghi nhớ đăng nhập"
        android:textColor="#FFFFFF"
        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="@id/edtPassword"
        app:layout_constraintTop_toBottomOf="@id/edtPassword"
        tools:layout_editor_absoluteX="35dp" />

    <TextView
        android:id="@+id/txtForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quên mật khẩu?"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"

        app:layout_constraintTop_toTopOf="@id/chkRemember"
        app:layout_constraintBottom_toBottomOf="@id/chkRemember"
        app:layout_constraintEnd_toEndOf="@id/edtPassword" />
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="340dp"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1a50df"
        android:text="ĐĂNG NHẬP"
        android:textAllCaps="false"
        android:textColor="#ffff"
        android:textSize="20sp"
        android:textStyle="bold"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtForgotPassword" />

    <TextView
        android:id="@+id/txtOr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="──────── Hoặc đăng nhập với ────────"
        android:textColor="#FFFFFF"
        android:textSize="14sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLogin" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogle"
        android:layout_width="169dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFFFFF"
        android:text="Google"
        android:textAllCaps="false"
        android:textColor="#202124"
        android:textSize="18sp"
        android:textStyle="bold"

        app:cornerRadius="12dp"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="24dp"

        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.064"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtOr"
        app:strokeColor="#DADCE0"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFacebook"
        android:layout_width="180dp"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFFFFF"

        android:text="Facebook"
        android:textAllCaps="false"
        android:textColor="#202124"
        android:textSize="18sp"
        android:textStyle="bold"

        app:cornerRadius="12dp"

        app:icon="@drawable/ic_facebook"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="24dp"
        app:iconTint="@null"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.794"
        app:layout_constraintStart_toEndOf="@id/btnGoogle"

        app:layout_constraintTop_toBottomOf="@id/txtOr"
        app:strokeColor="#DADCE0"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Chưa có tài khoản? Đăng ký ngay"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/btnGoogle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>